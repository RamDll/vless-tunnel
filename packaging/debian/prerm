#!/bin/sh
set -e

case "$1" in
  remove)
    if [ -f /etc/vless-tunnel/config.json ] || [ -f /etc/systemd/system/vless-tunnel.service ]; then
      /usr/bin/vless-tunnel uninstall --yes || true
    fi

    if command -v loginctl >/dev/null 2>&1; then
      loginctl list-sessions --no-legend 2>/dev/null | while read -r _session uid user _rest; do
        runtime_dir="/run/user/$uid"
        [ -S "$runtime_dir/bus" ] || continue
        su -s /bin/sh "$user" -c \
          "XDG_RUNTIME_DIR='$runtime_dir' DBUS_SESSION_BUS_ADDRESS='unix:path=$runtime_dir/bus' systemctl --user disable --now vless-tunnel-tray.service" \
          >/dev/null 2>&1 || true
      done
    fi
    ;;
esac

exit 0
